# Supabase 프로젝트의 두 값을 여기에 복사
# (Supabase Dashboard → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# 공공데이터포털 "특일 정보" 서비스키 (Decoding 키)
# https://www.data.go.kr → "특일 정보" 검색 → 활용신청 → 마이페이지 → 인증키
# 없어도 앱은 작동하지만 공휴일 자동 동기화가 비활성화됩니다.
HOLIDAY_API_KEY=

# Render 가 자동으로 PORT 를 주입하므로 보통 설정 불필요
# PORT=3000
